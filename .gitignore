# gstack per-project state (artifacts live in ~/.gstack, not in the repo)
.gstack/

# environment
.env
.env.production

# macOS
.DS_Store

# eval answers from the last run
evals/last-run/

# python bytecode
__pycache__/
*.pyc

# generated per machine by scripts/build-catalogue.sh — never committed
references/catalogue.md

# Your own arbitration now lives in ~/.which-skill/, outside this folder, because
# `npx skills update` overwrites the skill directory and destroys anything
# hand-written in it. This entry stays for anyone still holding one at the old
# path — build-catalogue.sh moves it on the next run.
references/arbitration.local.md
