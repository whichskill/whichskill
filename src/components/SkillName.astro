---
import { getEntry } from 'astro:content';
import { packOf } from '../lib/site.ts';

interface Props {
  id: string;
  /** Show the pack as a small link after the name. Off inside dense blocks. */
  showPack?: boolean;
  struck?: boolean;
  repeat?: number | 'N';
}

const { id, showPack = false, struck = false, repeat } = Astro.props;

// The integrity check has already guaranteed this resolves; the guard is here so
// a future refactor that skips the check fails loudly rather than rendering
// "undefined" into a published page.
const entry = await getEntry('skills', id);
if (!entry) throw new Error(`unresolved skill reference: ${id}`);

const pack = packOf(entry.data.pack);

// `name` is what you actually type, and it is NOT derivable from the id:
// `superpowers/brainstorming` is invoked as `/superpowers:brainstorming`, not
// `/brainstorming`. On a site whose whole promise is "type this", rendering a
// command that does not exist is the worst defect available.
const command = entry.data.name;
const slash = command.startsWith('/');
const body = slash ? command.slice(1) : command;
---

<span class={struck ? 'struck' : 'skill'}>
  {slash && <span class="slash">/</span>}{body}{
    repeat && <span class="repeat"> ×{repeat}</span>
  }
</span>{
  showPack && pack && (
    <>
      {' '}
      {pack.repoUrl ? (
        <a class="pack" href={pack.repoUrl} rel="noopener">{pack.label}</a>
      ) : (
        <span class="pack">{pack.label}</span>
      )}
    </>
  )
}
