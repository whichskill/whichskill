---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SkillName from '../../components/SkillName.astro';
import { renderVerdict } from '../../lib/verdict.ts';

export async function getStaticPaths() {
  const arbitrations = await getCollection('arbitrations');
  return arbitrations.map((arbitration) => ({
    params: { id: arbitration.id },
    props: { arbitration },
  }));
}

const { arbitration } = Astro.props;
const d = arbitration.data;

// Winners first, then losers in source order. The diff reads top-down.
const rows = [...d.competitors].sort((a, b) => Number(b.wins) - Number(a.wins));
---

<Base title={d.title} description={d.verdict}>
  <article class="plate">
    <div class="eyebrow">
      <span>Terrain</span>
      <span>{d.terrain} · {d.competitors.length} contenders</span>
    </div>
    <hr class="rule" />

    <h1>{d.title}</h1>

    <!-- The page's single amber occurrence. -->
    <p class="verdict" set:html={renderVerdict(d.verdict)} />

    <div class="diff">
      {
        rows.map((c) => (
          <div class={`row ${c.wins ? 'win' : 'lose'}`}>
            <span class="gutter">{c.wins ? '+' : '−'}</span>
            <div>
              <span class="name">
                <SkillName id={c.ref.id} showPack />
              </span>
              <p class="body">{c.why}</p>
              {!c.wins && c.whenItWins && <p class="when">When it wins: {c.whenItWins}</p>}
            </div>
          </div>
        ))
      }
    </div>

    {d.noneOfThem && <p class="note">{d.noneOfThem}</p>}
  </article>
</Base>
