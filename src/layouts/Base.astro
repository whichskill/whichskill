---
import { getCollection } from 'astro:content';
// Self-hosted and bundled, per DESIGN.md. A CDN link would make every local
// build depend on the network and put a third party in the render path.
import '@fontsource/commit-mono/500.css';
import '@fontsource/commit-mono/600.css';
import '../styles/global.css';
import { SITE_NAME } from '../lib/site.ts';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

// Counted, never hardcoded: the footer is the only navigation on the site, so a
// number that drifts from the corpus is a lie on every page at once.
const chainCount = (await getCollection('chains')).length;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} — {SITE_NAME}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@112,600;112,700&family=Literata:opsz,wght@7..72,400;7..72,600&family=JetBrains+Mono:wght@500;600&display=swap"
    />
  </head>
  <body>
    <slot />
    <!--
      No navigation in the first viewport, on purpose. The global index lives
      here, at the foot of every page: the back of the card. See DESIGN.md.
    -->
    <footer>
      <a href="/">All {chainCount} situation{chainCount > 1 ? 's' : ''}</a>
      <span>{SITE_NAME}</span>
    </footer>
  </body>
</html>
